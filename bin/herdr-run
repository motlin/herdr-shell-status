#!/usr/bin/env bash

set -u

watch_for_focus() {
  local herdr_bin="$1"
  local pane_id="$2"
  local source_id="$3"
  local agent_label="$4"
  local response
  local focused
  local attempt

  for ((attempt = 0; attempt < 43200; attempt++)); do
    response="$("$herdr_bin" pane get "$pane_id" 2>/dev/null)" || return 0
    focused="$(
      jq -r \
        'if (.result.pane.focused | type) == "boolean" then .result.pane.focused else error("focused must be boolean") end' \
        <<< "$response" 2>/dev/null
    )" || return 0
    if [[ "$focused" == true ]]; then
      "$herdr_bin" pane release-agent "$pane_id" \
        --source "$source_id" \
        --agent "$agent_label" >/dev/null 2>&1 || true
      return 0
    fi
    sleep 2
  done

  "$herdr_bin" pane release-agent "$pane_id" \
    --source "$source_id" \
    --agent "$agent_label" >/dev/null 2>&1 || true
}

if [[ "${1:-}" == __watch_for_focus ]]; then
  shift
  [[ $# -eq 4 ]] || exit 2
  watch_for_focus "$@"
  exit 0
fi

usage() {
  printf 'Usage: herdr-run [--label LABEL] -- COMMAND [ARG...]\n' >&2
}

agent_label=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --label)
      [[ $# -ge 2 ]] || {
        usage
        exit 2
      }
      agent_label="$2"
      shift 2
      ;;
    --)
      shift
      break
      ;;
    *)
      usage
      exit 2
      ;;
  esac
done

[[ $# -gt 0 ]] || {
  usage
  exit 2
}

if [[ -n "$agent_label" && ! "$agent_label" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$ ]]; then
  printf 'herdr-run: label must be 1-64 letters, digits, periods, underscores, or hyphens\n' >&2
  exit 2
fi

if [[ -z "$agent_label" ]]; then
  agent_label="${1##*/}"
  if [[ ! "$agent_label" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$ ]]; then
    agent_label="command"
  fi
fi

if [[ "${HERDR_ENV:-}" != 1 || -z "${HERDR_PANE_ID:-}" ]] || ! command -v jq >/dev/null 2>&1; then
  exec "$@"
fi

if [[ -n "${HERDR_BIN_PATH:-}" && -x "$HERDR_BIN_PATH" ]]; then
  herdr_bin="$HERDR_BIN_PATH"
elif herdr_bin="$(command -v herdr 2>/dev/null)"; then
  :
else
  exec "$@"
fi

pane_id="$HERDR_PANE_ID"
source_id="user:herdr-run:$$"
lifecycle_active=0

finish_lifecycle() {
  local command_status=$?
  local final_state
  local -a report_arguments

  trap - EXIT
  [[ "$lifecycle_active" == 1 ]] || return "$command_status"

  if [[ "$command_status" -eq 0 || "$command_status" -eq 130 || "$command_status" -eq 137 || "$command_status" -eq 143 ]]; then
    final_state=idle
  else
    final_state=blocked
  fi

  report_arguments=(
    pane report-agent "$pane_id"
    --source "$source_id"
    --agent "$agent_label"
    --state "$final_state"
  )
  if [[ "$final_state" == blocked ]]; then
    report_arguments+=(--message "command exited with status $command_status")
  fi

  if "$herdr_bin" "${report_arguments[@]}" >/dev/null 2>&1; then
    nohup "$0" __watch_for_focus "$herdr_bin" "$pane_id" "$source_id" "$agent_label" \
      </dev/null >/dev/null 2>&1 &
  fi

  return "$command_status"
}

if "$herdr_bin" pane report-agent "$pane_id" \
  --source "$source_id" \
  --agent "$agent_label" \
  --state working >/dev/null 2>&1; then
  lifecycle_active=1
  trap finish_lifecycle EXIT
fi

"$@"
